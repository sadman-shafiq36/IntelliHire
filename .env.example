APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

POSTGRES_USER=intellihire
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=intellihire
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CHROMA_HOST=chroma
CHROMA_PORT=8000

JWT_SECRET_KEY=generate-a-long-random-value-and-keep-it-out-of-git
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

WHISPER_SERVICE_URL=http://whisper:9000
WHISPER_MODEL_SIZE=base.en
WHISPER_COMPUTE_TYPE=int8
AUDIO_CHUNK_SECONDS=4

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@intellihire.local
SMTP_FROM_NAME=IntelliHire

STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=10
ALLOWED_CV_EXTENSIONS=.pdf,.docx
ALLOWED_POLICY_EXTENSIONS=.pdf,.docx,.txt,.md
POLICY_CHUNK_CHARS=1200
POLICY_CHUNK_OVERLAP=200
POLICY_MIN_SCORE=0.55
SCREENING_CONCURRENCY=3

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback
LINKEDIN_API_VERSION=202609

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_FORM_TEMPLATE_ID=

VITE_API_BASE_URL=http://localhost:8000
